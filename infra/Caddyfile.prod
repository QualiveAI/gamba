{
    admin off
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }

    @private path /metrics /health /health/* /docs /redoc /openapi.json
    handle @private {
        respond 404
    }

    handle_path /app/* {
        root * /srv/app
        @app_assets path_regexp app_assets \.((webp|png|jpg|jpeg|svg|ico))$
        handle @app_assets {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
    handle {
        # URL webhook не содержит bot token; access logs намеренно не включены.
        reverse_proxy api:8000 {
            health_uri /health/ready
            health_interval 10s
            health_timeout 4s
            health_status 200
            health_fails 2
            health_passes 2
            transport http {
                dial_timeout 3s
                response_header_timeout 30s
            }
        }
    }
}
