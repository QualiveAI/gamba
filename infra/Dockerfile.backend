FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY backend/pyproject.toml backend/ruff.toml ./
COPY backend/app ./app
COPY backend/core ./core
COPY backend/plugins ./plugins
COPY backend/configs ./configs
COPY backend/locales ./locales
COPY backend/migrations ./migrations
COPY backend/tools ./tools
COPY infra/entrypoint.prod.sh /entrypoint.prod.sh

RUN pip install --no-cache-dir . \
    && useradd -m -u 1000 appuser \
    && mkdir -p /app/media \
    && chmod 0755 /entrypoint.prod.sh \
    && chown -R appuser:appuser /app

USER appuser
EXPOSE 8000

# Единая точка входа: API + bot worker + scheduler + provisioning в одном контейнере.
# Голый uvicorn здесь недопустим — тогда на Render не будет ни worker, ни scheduler.
CMD ["/entrypoint.prod.sh"]
