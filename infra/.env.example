# Локальная среда. Значения ниже не являются production credentials.
ENV=dev
WEBAPP_URL=http://localhost:8090/app/
PUBLIC_BASE_URL=
ALLOW_GUEST_AUTH=false
BOT_MODE=disabled
MANAGED_BOTS_ENABLED=false
PAYMENTS_MODE=disabled
PAYMENT_WEB_ENABLED=false
STARS_ENABLED=false
GIFTS_ENABLED=false
GIFTCARD_MODE=disabled
GIFTCARD_REDEMPTION_ENABLED=false
MEDIA_STORAGE_MODE=local

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_TTL_SECONDS=86400
FERNET_KEY=
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
METRICS_TOKEN=

DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_TIMEOUT_SECONDS=3
READINESS_TIMEOUT_SECONDS=2
EXPECTED_SCHEMA_VERSION=0018_giftcard_redemption.sql

# Для production скопируйте этот шаблон ВНЕ репозитория и заполните явно.
# Не source файл и не выводите docker compose config без --quiet.
# Production compose требует --env-file и PRODUCTION_ENV_FILE с одним файлом.
# ENV=prod
# PUBLIC_DOMAIN=app.example.invalid
# DATABASE_URL=postgresql://app_user:REPLACE_PASSWORD@db.example.invalid:5432/windrop?sslmode=verify-full
# MIGRATION_DATABASE_URL=postgresql://migration_user:REPLACE_PASSWORD@db.example.invalid:5432/windrop?sslmode=verify-full
# REDIS_URL=redis://redis:6379/0
# PUBLIC_BASE_URL=https://app.example.invalid
# WEBAPP_URL=https://app.example.invalid/app/
# BACKEND_IMAGE=windrop-backend:release-tag
# В production JWT/Fernet/webhook keys должны быть уникальными; live opt-in отдельно.
# BOT_MODE=webhook
