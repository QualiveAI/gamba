# Allowlist: в build context отправляются только файлы backend image.
**
!backend/
!backend/pyproject.toml
!backend/ruff.toml
!backend/app/
!backend/app/**
!backend/core/
!backend/core/**
!backend/plugins/
!backend/plugins/**
!backend/configs/
!backend/configs/**
!backend/locales/
!backend/locales/**
!backend/migrations/
!backend/migrations/**
!backend/tools/
!backend/tools/**
!infra/
!infra/Dockerfile.backend
!infra/Dockerfile.backend.dockerignore
!infra/entrypoint.prod.sh

# Секреты и артефакты исключаются и внутри разрешённых директорий.
**/.env
**/.env.*
**/*secret*
**/*credentials*
**/*token*.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.dump
**/*.backup
**/*.sql.gz
**/*.db
**/*.sqlite*
**/backups
**/backups/**
**/secrets
**/secrets/**
**/dumps
**/dumps/**
**/.git
**/.zcode
**/.cagent
**/.venv
**/venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.log
**/temp_vars
**/БОТ.txt
