{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "routes": [
    { "src": "/", "dest": "/landing/index.html" },
    { "src": "/app", "dest": "/frontend/index.html" },
    { "src": "/app/", "dest": "/frontend/index.html" },
    { "src": "/app/(.*)", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/landing/$1" }
  ],
  "crons": [
    { "path": "/api/cron/auto_pause", "schedule": "*/10 * * * *" }
  ]
}
