# Шаблон env для windrop вне ПК. Заполнить своими значениями, НЕ коммитить.
# Vercel: эти же ключи вносятся в Settings → Environment Variables.
# Neon: DATABASE_URL (pooled, sslmode=require). Upstash: REDIS_URL (rediss://).

DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# Telegram-бот (webhook-режим на публичном домене)
bot_token=
bot_username=
telegram_webhook_secret=
admin_telegram_ids=
healthcheck_bot_token=
healthcheck_target_chat_id=
managed_bots_enabled=false

# Auth
jwt_secret=         # openssl rand -hex 32
jwt_ttl_seconds=86400
fernet_key=         # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
allow_guest_auth=false

# Roblox OAuth
roblox_client_id=
roblox_client_secret=
roblox_redirect_uri=https://<vercel-domain>/auth/roblox/callback

# Публичные адреса (обязательны для кнопок бота и webhook'ов)
webapp_url=https://<cf-pages-domain>/app/
public_base_url=https://<vercel-domain>

# Платежи (включать только когда настроено)
yoomoney_client_id=
yoomoney_client_secret=
yoomoney_redirect_uri=
yoomoney_webhook_secret=
payment_web_enabled=false
paymento_api_key=
paymento_secret_key=
stars_enabled=false
gifts_enabled=false
stars_refunds_enabled=false

env=production
log_level=INFO
support_username=
